PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (or local: mongodb://127.0.0.1:27017/taskflow)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/taskflow

# JWT
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Cookie
JWT_COOKIE_EXPIRES_DAYS=7

# Frontend origin (for CORS)
CLIENT_URL=http://localhost:5173

# Groq API key — get one free at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Logging level: error | warn | info | http | debug (defaults to debug in dev, info in prod)
LOG_LEVEL=debug

# Sentry error tracking — optional. Leave blank to disable entirely.
SENTRY_DSN=

# Cloudinary — free tier at https://cloudinary.com, used for task attachments
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
